{
  "name": "ampd",
  "private": true,
  "scripts": {
    "format": "ng lint --fix && prettier --write \"src/**/*.scss\" && package-lock-sanitizer",
    "warnings": "ng lint --silent --format=checkstyle > checkstyle-ts-result.xml",
    "lint": "ng lint",
    "ng": "ng",
    "start": "ng serve",
    "e2e": "ng e2e",
    "cypress:open": "ng run ampd:cypress-open",
    "cypress:run": "cypress run",
    "delete:reports": "rm cypress/results/* || true",
    "generate:reports": "npx mochawesome-merge \"cypress/results/*.json\" > mochawesome.json && marge -o reports/html mochawesome.json && rm mochawesome.json"
  },
  "dependencies": {
    "@angular-devkit/core": "22.1.2",
    "@angular/cdk": "22.1.0",
    "@angular/common": "22.1.0",
    "@angular/compiler": "22.1.0",
    "@angular/core": "22.1.0",
    "@angular/forms": "22.1.0",
    "@angular/material": "22.1.0",
    "@angular/platform-browser": "22.1.0",
    "@angular/router": "22.1.0",
    "@stomp/rx-stomp": "2.4.0",
    "fast-equals": "6.0.2",
    "material-icons": "1.13.14",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "22.1.2",
    "@angular/compiler-cli": "22.1.0",
    "@cypress/schematic": "5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.4.0",
    "angular-eslint": "22.1.0",
    "autoprefixer": "10.5.4",
    "cypress": "latest",
    "cypress-multi-reporters": "2.0.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "mochawesome": "8.0.1",
    "mochawesome-merge": "5.1.1",
    "mochawesome-report-generator": "6.3.2",
    "npm-check-updates": "23.0.1",
    "package-lock-sanitizer": "1.0.4",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.17",
    "typescript-eslint": "8.65.0"
  }
}
